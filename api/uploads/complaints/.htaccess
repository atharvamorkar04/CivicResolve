# Disable script execution in uploads directory
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|cgi|sh|exe|asp|aspx|jsp)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .cgi
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
